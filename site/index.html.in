  <meta name="description" content="Keep your experience, its evidence, reviewed résumés and applications together. BonaFides is an early-stage, self-hosted job-search workspace for Mac and Linux.">
  <meta name="color-scheme" content="light">
  <title>BonaFides — Your experience, with the evidence attached</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="brand" href="#main" aria-label="BonaFides home">BonaFides</a>
    <nav aria-label="Main navigation">
      <a href="#workflow">How it works</a>
      <a href="#install">Install locally</a>
